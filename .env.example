# Public Supabase project configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only Supabase credential (never prefix with NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Stripe sandbox/test credentials
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PHYSICAL_PRICE_ID=price_replace_me
STRIPE_DIGITAL_PRICE_ID=price_replace_me
STRIPE_SUBSCRIPTION_PRICE_ID=price_replace_me

# Canonical origin, without a trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated staff account UUIDs; optional for customer journeys
STAFF_USER_IDS=
